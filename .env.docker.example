# Local/default Docker values
APP_DOMAIN=app.example.com
SIGNALING_DOMAIN=signal.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SIGNALING_URL=https://signal.example.com
NEXT_PUBLIC_MAX_PARTICIPANTS=5

# Production TURN example
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"]}]
TURN_USERNAME=streamzon
TURN_PASSWORD=replace-with-strong-secret

# VPS/public origins
SIGNALING_ALLOWED_ORIGIN=https://app.example.com
