NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SIGNALING_URL=https://your-signaling.example.com
NEXT_PUBLIC_MAX_PARTICIPANTS=5

# The room page serializes these ICE server definitions to the browser.
# Keep TURN URLs here so clients can connect through NAT/firewall in production.
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"]}]
TURN_USERNAME=streamzon
TURN_PASSWORD=replace-with-strong-secret
